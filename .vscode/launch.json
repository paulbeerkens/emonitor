{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "EMonitor: collector",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/main.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env"
    },
    {
      "name": "EMonitor: web",
      "type": "debugpy",
      "request": "launch",
      "module": "flask",
      "args": ["--app", "web:create_app", "run", "--debug"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env"
    }
  ],
  "compounds": [
    {
      "name": "EMonitor: collector + web",
      "configurations": ["EMonitor: collector", "EMonitor: web"],
      "stopAll": true
    }
  ]
}
